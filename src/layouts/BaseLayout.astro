---
import Header from "@components/Header.astro";
import { withBase } from "../utils/paths";
import "@styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Information om HEMA Odense." } = Astro.props;
const pageTitle = title === "HEMA Odense" ? title : `${title} | HEMA Odense`;
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={withBase("/images/brand/Hema_odense_logo.png")} />
    <link rel="apple-touch-icon" href={withBase("/images/brand/Hema_odense_logo.png")} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-column">
        <h2>Adresse</h2>
        <p>
          Rosenbæk Torv 30<br />
          5000 Odense
        </p>
      </div>
      <div class="footer-column">
        <h2>Kontakt</h2>
        <p>Email: <a href="mailto:odensehema@gmail.com">odensehema@gmail.com</a></p>
      </div>
      <div class="footer-column">
        <h2>Følg os</h2>
        <ul class="footer-links">
          <li>
            <a href="https://www.facebook.com/profile.php?id=100094571515526" rel="noreferrer" target="_blank">
              Facebook
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/hema.odense?igsh=MW95eTMxaGQ3dGQ4ZA==" rel="noreferrer" target="_blank">
              Instagram
            </a>
          </li>
          <li>
            <a href="https://www.youtube.com/@HEMAOdense" rel="noreferrer" target="_blank">
              YouTube
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>
