---
import Hero from "@components/Hero.astro";
import PersonGrid from "@components/PersonGrid.astro";
import { board, trainers } from "@data/people";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Bestyrelse og trænere" description="Bestyrelse og trænere hos HEMA Odense.">
  <Hero
    title="Bestyrelse og trænere"
    subtitle="Mød de frivillige bag klubben"
    image="/images/hero/Chair_game.jpg"
  />

  <section class="content-section narrow">
    <h2>Hvem kan du møde?</h2>
    <p>
      HEMA Odense drives af frivillige trænere og bestyrelsesmedlemmer, som står for den daglige træning, klubbens aktiviteter og det praktiske arbejde bag foreningen.
    </p>
    <p>
    Til træning møder du typisk flere af vores trænere på gulvet. De hjælper både nye og erfarne medlemmer med teknik, sikkerhed og at finde sig godt til rette i klubben.
    </p>
  </section>

  <PersonGrid title="Trænere" people={trainers} />
  <PersonGrid title="Bestyrelsen" people={board} />
</BaseLayout>
