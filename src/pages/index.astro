---
import Hero from "@components/Hero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
---

<BaseLayout title="HEMA Odense" description="Forside for HEMA Odense.">
  <Hero
    title="HEMA Odense"
    subtitle="Historisk fægtning i hjertet af Odense"
  />

  <section class="content-section intro-grid">
    <div>
      <p class="eyebrow">Historical European Martial Arts</p>
      <h2>Velkommen til HEMA Odense</h2>
      <p>
        Du har fundet Odenses lokale HEMA-klub. Vi holder til ved Kulturmaskinen i centrum. Hvor vi underviser i langsværd og sabelfægtning.
      </p>
      <p>
        Hos os finder du et inkluderende fællesskab hvor du lærer fægtekunst i sikre omgivelser. Vi tager træningen seriøst, men der er plads til både begyndere, spørgsmål og godt humør.
      </p>

      <p>
        Følg med i vores aktivitet på vores sociale medier:
      </p>
      <div class="social-links" aria-label="Sociale medier">
        <a href="https://www.facebook.com/profile.php?id=100094571515526" rel="noreferrer" target="_blank">
          Facebook
        </a>
        <a href="https://www.instagram.com/hema.odense?igsh=MW95eTMxaGQ3dGQ4ZA==" rel="noreferrer" target="_blank">Instagram</a>
        <a href="https://www.youtube.com/@HEMAOdense" rel="noreferrer" target="_blank">YouTube</a>
      </div>
      <div class="button-row">
        <a class="button" href="mailto:odensehema@gmail.com">Kontakt os</a>
        <a class="button secondary" href={withBase("/hvad-er-hema/")}>Hvad er HEMA?</a>
      </div> 
    </div>
    <img src={withBase("/images/gifs/hema-blade-actions-supercut-60s.gif")} alt="HEMA træning placeholder" />
  </section>

  <section class="highlight-band" id="gratis-proevetraening">
    <div>
      <p class="eyebrow">Kontakt</p>
      <h2>Gratis prøvetræning</h2>
      <p>
        Vi holder åbent for drop-in hver onsdag. Kom forbi og se hvad HEMA er. Dine første 4 træninger er gratis og efter det koster et medlemskab kun 200 kr om måneden (100 kr for studerende) 
        for det får du 8 træningshold om måneden afholdt af vores dedikerede frivillige trænere.
        Vi koordinere vores træninger på facebook så tilmeld dig vores
        <a href="https://www.facebook.com/groups/1201015829986327/" rel="noreferrer" target="_blank">
          facebook gruppe.
        </a>
      </p>
      <p>
        Vi stiller lånergrej til rådighed og hjælper med rådgivning til når du skal bestille dit eget.
      </p>
    </div>
    <dl class="contact-list">
      <div>
        <dt>Email</dt>
        <dd><a href="mailto:odensehema@gmail.com">odensehema@gmail.com</a></dd>
      </div>
      <div>
        <dt>Træning</dt>
        <dd>Mandag & onsdag kl. 17-20</dd>
      </div>
      <div>
        <dt>Sted</dt>
        <dd>Rosenbæk Torv 30, 5000 Odense</dd>
      </div>
    </dl>
  </section>
</BaseLayout>
