---
import Hero from "@components/Hero.astro";
import SponsorGrid from "@components/SponsorGrid.astro";
import { sponsors } from "@data/sponsors";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Sponsorer" description="Sponsorer og samarbejdspartnere hos HEMA Odense.">
  <Hero
    title="Sponsorer"
    subtitle="Vores sponsorer hjælper os med at skabe gode rammer for historisk fægtning i Odense."
    image="/images/hero/sponsors-welcome-1485999623.jpg"
  />

  <section class="content-section narrow">
    <p class="eyebrow">Støt klubben</p>
    <h2>Tak til vores sponsorer</h2>
    <p>
      HEMA Odense er drevet af frivillige, og sponsorstøtte gør en konkret forskel for
      vores medlemmer. Det hjælper os med at holde udgifterne nede, købe og vedligeholde
      låneudstyr, skabe bedre træningsrammer og gøre det nemmere for nye fægtere at
      komme godt i gang.
    </p>
    <p>
      Når en virksomhed eller organisation støtter klubben, støtter de også et lokalt
      fællesskab omkring bevægelse, historie, frivillighed og sikker træning. Vi er
      derfor meget taknemmelige for de sponsorer og samarbejdspartnere, der er med til
      at udvikle HEMA i Odense.
    </p>
  </section>

  <section class="content-section">
    <SponsorGrid sponsors={sponsors} />
  </section>
</BaseLayout>
