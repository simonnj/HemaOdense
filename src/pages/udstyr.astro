---
import Hero from "@components/Hero.astro";
import { gearRecommendations, gearSections } from "@data/gear";
import BaseLayout from "@layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";
---

<BaseLayout title="Udstyr" description="Udstyrsanbefalinger for HEMA Odense.">
  <Hero
    title="Udstyr"
    subtitle="Vi skal kunne slås sikkert."
    image="/images/hero/gear_placeholder.jpg"
  />

  <section class="content-section narrow">
    <p class="eyebrow">Udstyrs anbefalinger</p>
    <h2>Hvad skal du bruge?</h2>
    <p>
      HEMA er en fuld kontakt sport hvor vi slår på hinanden med metal simulatore af våben. 
      Derfor stiller vi høje krav til sikkerheden i vores klub. Det har sørget for vi har utroligt få skader i klubben.

    </p>
    <p>
      Derfor har vi sammensat anbefalinger af udstyr her under som bygger på klubbens egne erfaringer.
    </p>
  </section>

  <section class="content-section gear-list">
    {
      gearSections.map((section) => (
        <article>
          <h2>{section.title}</h2>
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="content-section recommendation-section">
    <div class="section-heading">
      <p class="eyebrow">Anbefalet udstyr</p>
      <h2>Konkrete anbefalinger</h2>
      <p>
        Klubbens anbefalinger er bygget på de erfaringer af grej vi har fået over årene og er ikke dækkende for alle produkter på markedet. Hvis du finder et produkt du er interresset i spørg en træner inden du bruger dine penge på det.
      </p>
    </div>
    <div class="recommendation-list">
      {
        gearRecommendations.map((item) => (
          <article class="recommendation-card">
            <p class="eyebrow">{item.category}</p>
            <h3>{item.recommendation}</h3>
            <p>{item.notes}</p>
            <div class="product-list">
              {item.products.map((product) => (
                <a class="product-card" href={product.href} rel="noreferrer" target="_blank">
                  <img
                    src={withBase(product.image)}
                    alt={`Produktbillede: ${product.label}`}
                    loading="lazy"
                  />
                  <span>{product.label}</span>
                </a>
              ))}
            </div>
            {item.products.length > 1 && (
              <div class="recommendation-links">
                {item.products.map((product) => (
                  <a class="text-link" href={product.href} rel="noreferrer" target="_blank">
                    {product.label}
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
