---
import Hero from "@components/Hero.astro";
import { gearRecommendations, gearSections } from "@data/gear";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Udstyr" description="Udstyrsanbefalinger for HEMA Odense.">
  <Hero
    title="Udstyr"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
    image="/images/hero/gear_placeholder.jpg"
  />

  <section class="content-section narrow">
    <p class="eyebrow">Gear anbefalinger</p>
    <h2>Hvad skal du bruge?</h2>
    <p>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor
      incididunt ut labore et dolore magna aliqua.
    </p>
  </section>

  <section class="content-section gear-list">
    {
      gearSections.map((section) => (
        <article>
          <h2>{section.title}</h2>
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="content-section recommendation-section">
    <div class="section-heading">
      <p class="eyebrow">Anbefalet udstyr</p>
      <h2>Konkrete anbefalinger</h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor
        incididunt ut labore et dolore magna aliqua.
      </p>
    </div>
    <div class="recommendation-list">
      {
        gearRecommendations.map((item) => (
          <article class="recommendation-card">
            <p class="eyebrow">{item.category}</p>
            <h3>{item.recommendation}</h3>
            <p>{item.notes}</p>
            {item.link && (
              <a class="text-link" href={item.link} rel="noreferrer" target="_blank">
                Se eksempel
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
